# Google Smart Fleet Logistics Environment Configuration
# Copy this file to .env and fill in values if available

# Google Gemini API Key (get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Maps / Routes API Key (optional, falls back to nearest-neighbor TSP)
GOOGLE_MAPS_API_KEY=

# Shared Secret Token for Driver App / GPS Telemetry Ingestion (optional)
TRACKER_TOKEN=

# Server Port (default: 8080)
PORT=8080

